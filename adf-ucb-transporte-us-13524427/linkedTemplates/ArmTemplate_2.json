	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/df_silver_incidentes')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "silver"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "dw_bronze_incidentes_sql",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "dw_silver_incidentes_sql",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "derivedColumn2"
						},
						{
							"name": "derivedColumn3"
						}
					],
					"scriptLines": [
						"source(output(",
						"          AnioFuente as short,",
						"          IncidenteId as string,",
						"          TipoIncidente as string,",
						"          Severidad as string,",
						"          FechaHoraInicio as string,",
						"          FechaHoraFin as string,",
						"          FechaHoraRegistro as string,",
						"          VehiculoId as string,",
						"          Descripcion as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"source1 derive(TipoIncidente = upper(trim(TipoIncidente)),",
						"          Severidad = upper(trim(Severidad)),",
						"          AnioFuente = toShort(\r",
						"    year(\r",
						"        iif(\r",
						"            instr(left(FechaHoraInicio,10), '/') > 0,\r",
						"            toDate(left(FechaHoraInicio,10), 'dd/MM/yyyy'),\r",
						"            iif(\r",
						"                instr(left(FechaHoraInicio,10), '-') > 0,\r",
						"                toDate(left(FechaHoraInicio,10), 'yyyy-MM-dd'),\r",
						"                addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(left(FechaHoraInicio,10)))\r",
						"            )\r",
						"        )\r",
						"    )\r",
						")) ~> derivedColumn1",
						"derivedColumn1 derive(VehiculoId = iif(isNull(VehiculoId) || VehiculoId == '', 'No asignado', trim(VehiculoId)),",
						"          Descripcion = trim(Descripcion)) ~> derivedColumn2",
						"derivedColumn2 derive(FechaHoraInicio = iif(\r",
						"    isNull(FechaHoraInicio) || trim(FechaHoraInicio) == '',\r",
						"    toTimestamp(null()),\r",
						"    toTimestamp(trim(FechaHoraInicio), 'dd/MM/yyyy')\r",
						"),",
						"          FechaHoraFin = iif(\r",
						"    isNull(FechaHoraFin) || trim(FechaHoraFin) == '',\r",
						"    toTimestamp(null()),\r",
						"    toTimestamp(trim(FechaHoraFin), 'dd/MM/yyyy')\r",
						"),",
						"          FechaHoraRegistro = iif(\r",
						"    isNull(FechaHoraRegistro) || trim(FechaHoraRegistro) == '',\r",
						"    toTimestamp(null()),\r",
						"    toTimestamp(\r",
						"        concat(trim(FechaHoraRegistro), ' 00:00'),\r",
						"        'dd/MM/yyyy HH:mm'\r",
						"    )\r",
						")) ~> derivedColumn3",
						"derivedColumn3 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          AnioFuente as integer,",
						"          IncidenteId as string,",
						"          TipoIncidente as string,",
						"          Severidad as string,",
						"          FechaHoraInicio as timestamp,",
						"          FechaHoraFin as timestamp,",
						"          FechaHoraRegistro as timestamp,",
						"          VehiculoId as string,",
						"          Descripcion as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          AnioFuente,",
						"          IncidenteId,",
						"          TipoIncidente,",
						"          Severidad,",
						"          FechaHoraInicio,",
						"          FechaHoraFin,",
						"          FechaHoraRegistro,",
						"          VehiculoId,",
						"          Descripcion",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_silver_paradas')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "silver"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "dw_bronze_paradas_sql",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "dw_silver_paradas_sql",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "derivedColumn2"
						},
						{
							"name": "derivedColumn3"
						},
						{
							"name": "AlterRow1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          AnioFuente as short,",
						"          ParadaHistoricaId as string,",
						"          CodigoPublicado as string,",
						"          NombreParada as string,",
						"          Zona as string,",
						"          Latitud as string,",
						"          Longitud as string,",
						"          VigenciaDesde as string,",
						"          VigenciaHasta as string,",
						"          Estado as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"source1 derive(ParadaHistoricaId = trim(ParadaHistoricaId),",
						"          NombreParada = trim(NombreParada),",
						"          Zona = upper(trim(Zona)),",
						"          Estado = upper(trim(Estado)),",
						"          CodigoPublicado = ParadaHistoricaId,",
						"          AnioFuente = toShort(\r",
						"    year(\r",
						"        iif(\r",
						"            instr(VigenciaDesde, '/') > 0,\r",
						"            toDate(VigenciaDesde, 'dd/MM/yyyy'),\r",
						"            iif(\r",
						"                instr(VigenciaDesde, '-') > 0,\r",
						"                toDate(VigenciaDesde, 'yyyy-MM-dd'),\r",
						"                addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(VigenciaDesde))\r",
						"            )\r",
						"        )\r",
						"    )\r",
						")) ~> derivedColumn1",
						"derivedColumn1 derive(Latitud = toDecimal(trim(Latitud)),",
						"          Longitud = toDecimal(trim(Longitud))) ~> derivedColumn2",
						"derivedColumn2 derive(VigenciaDesde = iif(\r",
						"    instr(VigenciaDesde, '/') > 0,\r",
						"    toDate(VigenciaDesde, 'dd/MM/yyyy'),\r",
						"    toDate(VigenciaDesde, 'yyyy-MM-dd')\r",
						"),",
						"          VigenciaHasta = iif(\r",
						"    instr(VigenciaHasta, '/') > 0,\r",
						"    toDate(VigenciaHasta, 'dd/MM/yyyy'),\r",
						"    toDate(VigenciaHasta, 'yyyy-MM-dd')\r",
						")) ~> derivedColumn3",
						"derivedColumn3 alterRow(upsertIf(true())) ~> AlterRow1",
						"AlterRow1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          AnioFuente as integer,",
						"          ParadaHistoricaId as string,",
						"          CodigoPublicado as string,",
						"          NombreParada as string,",
						"          Zona as string,",
						"          Latitud as decimal(9,6),",
						"          Longitud as decimal(9,6),",
						"          VigenciaDesde as date,",
						"          VigenciaHasta as date,",
						"          Estado as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:true,",
						"     upsertable:true,",
						"     keys:['AnioFuente','ParadaHistoricaId'],",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          AnioFuente,",
						"          ParadaHistoricaId,",
						"          CodigoPublicado,",
						"          NombreParada,",
						"          Zona,",
						"          Latitud,",
						"          Longitud,",
						"          VigenciaDesde,",
						"          VigenciaHasta,",
						"          Estado",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
