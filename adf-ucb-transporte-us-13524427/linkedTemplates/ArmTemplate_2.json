						"          Origen as string,",
						"          Destino as string,",
						"          VigenciaDesde as date,",
						"          VigenciaHasta as date,",
						"          Estado as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          AnioFuente,",
						"          RutaHistoricaId,",
						"          CodigoRuta,",
						"          NombreRuta,",
						"          Origen,",
						"          Destino,",
						"          VigenciaDesde,",
						"          VigenciaHasta,",
						"          Estado",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
