{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(RutaHistoricaId = upper(trim(RutaHistoricaId)),",
				"          VehiculoId = upper(trim(VehiculoId)),",
				"          EstadoViaje = upper(trim(EstadoViaje)),",
				"          AnioFuente = toString(year(toDate(FechaServicio, 'yyyy-MM-dd')))) ~> derivedColumn1",
				"derivedColumn1 derive(KmRecorridos = iif(isNull(KmRecorridos), '0.0', replace(toString(KmRecorridos), ',', '.')),",
				"          ValidacionesTarjeta = iif(\r",
				"    isNull(ValidacionesTarjeta) || trim(ValidacionesTarjeta) == '',\r",
				"    0,\r",
				"    toInteger(ValidacionesTarjeta)\r",
				")) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}