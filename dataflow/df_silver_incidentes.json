{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(TipoIncidente = upper(trim(TipoIncidente)),",
				"          Severidad = upper(trim(Severidad))) ~> derivedColumn1",
				"derivedColumn1 derive(VehiculoId = iif(isNull(VehiculoId) || VehiculoId == '', 'No asignado', trim(VehiculoId)),",
				"          Descripcion = trim(Descripcion)) ~> derivedColumn2",
				"derivedColumn2 derive(FechaHoraInicio = iif(\r",
				"    isNull(FechaHoraInicio) || trim(FechaHoraInicio) == '',\r",
				"    toTimestamp(null()),\r",
				"    toTimestamp(trim(FechaHoraInicio), 'dd/MM/yyyy')\r",
				"),",
				"          FechaHoraFin = iif(\r",
				"    isNull(FechaHoraFin) || trim(FechaHoraFin) == '',\r",
				"    toTimestamp(null()),\r",
				"    toTimestamp(trim(FechaHoraFin), 'dd/MM/yyyy')\r",
				"),",
				"          FechaHoraRegistro = iif(\r",
				"    isNull(FechaHoraRegistro) || trim(FechaHoraRegistro) == '',\r",
				"    toTimestamp(null()),\r",
				"    toTimestamp(\r",
				"        concat(trim(FechaHoraRegistro), ' 00:00'),\r",
				"        'dd/MM/yyyy HH:mm'\r",
				"    )\r",
				")) ~> derivedColumn3",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as integer,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}